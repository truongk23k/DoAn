using System.Collections;
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.Audio;

public class SaveLoad : MonoBehaviour
{
    public AudioMixer audioMixer;
    [SerializeField] private float sliderMultiplier = 25;
    public string sfxParametr = "sfx";     // ← Đặt default value
    public string bgmParametr = "bgm";     // ← Đặt default value

    private void Awake()
    {
        Debug.Log("SaveLoad.Awake() - Loading audio settings");

        // Kiểm tra AudioMixer có được gán không
        if (audioMixer == null)
        {
            Debug.LogError("AudioMixer is NULL! Cannot set audio levels.");
            return;
        }

        // Load SFX
        float sfxValue = PlayerPrefs.GetFloat(sfxParametr, 0.7f);
        float newSFXValue = Mathf.Log10(sfxValue) * sliderMultiplier;
        audioMixer.SetFloat(sfxParametr, newSFXValue);

        // Verify: Đọc lại giá trị vừa set
        audioMixer.GetFloat(sfxParametr, out float readSfxValue);
        Debug.Log($"Set SFX: {sfxValue} → {newSFXValue}dB | Read back: {readSfxValue}dB");

        // Load BGM
        float bgmValue = PlayerPrefs.GetFloat(bgmParametr, 0.7f);
        float newBGMValue = Mathf.Log10(bgmValue) * sliderMultiplier;
        audioMixer.SetFloat(bgmParametr, newBGMValue);

        // Verify: Đọc lại giá trị vừa set
        audioMixer.GetFloat(bgmParametr, out float readBgmValue);
        Debug.Log($"Set BGM: {bgmValue} → {newBGMValue}dB | Read back: {readBgmValue}dB");
    }
}
